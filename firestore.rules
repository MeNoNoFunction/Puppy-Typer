rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Your save: only you can read or write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Username claims: anyone signed in can check one; you can only claim a free name for yourself.
    match /usernames/{name} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,16}$');
      allow update, delete: if false;
    }

    // Public profile (for a leaderboard later). Readable by everyone, but the
    // username on it must be one that you have really claimed.
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == request.auth.uid;
      allow delete: if false;
    }
  }
}
